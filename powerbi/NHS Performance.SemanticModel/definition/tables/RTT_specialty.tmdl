				    Source = LoadParquet("fact_rtt_specialty"),
				    Kept = Table.SelectColumns(Source, {"month_key", "provider_code", "treatment_function_code", "waiting_list", "within_18", "over_52"}),
				    Typed = Table.TransformColumnTypes(Kept, {{"month_key", Int64.Type}, {"provider_code", type text}, {"treatment_function_code", type text}, {"waiting_list", type number}, {"within_18", type number}, {"over_52", type number}})
