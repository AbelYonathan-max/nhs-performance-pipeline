model Model
	culture: en-GB
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-GB
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["DataRoot", "LoadParquet", "Measures", "Month", "Region", "Organisation", "Specialty", "A&E", "RTT", "RTT specialty", "RTT England", "Forecast", "Model scores", "Targets", "Data checks", "Unusual months", "Load log"]

annotation __PBI_TimeIntelligenceEnabled = 0

ref table Measures
ref table Month
ref table Region
ref table Organisation
ref table Specialty
ref table 'A&E'
ref table RTT
ref table 'RTT specialty'
ref table 'RTT England'
ref table Forecast
ref table 'Model scores'
ref table Targets
ref table 'Data checks'
ref table 'Unusual months'
ref table 'Load log'
